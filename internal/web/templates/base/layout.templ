package base

import templpkg "github.com/a-h/templ"

type Page struct {
	Title         string
	Theme         string
	BodyClass     string
	ActiveSection string
	UseHTMX       bool
	Styles        []string
}

templ IndexPage(page Page, workspace templpkg.Component) {
	<!doctype html>
	<html lang="en" data-theme={ page.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title }</title>
			<link rel="icon" href="/assets/chopstick.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="/assets/filingweb.css"/>
			for _, stylesheet := range page.Styles {
				<link rel="stylesheet" href={ stylesheet }/>
			}
			if page.UseHTMX {
				<script src="/assets/htmx.min.js"></script>
			}
		</head>
		<body class={ page.BodyClass }>
			<header class="app-header">
				<a href="/" class="app-brand">Chopstick</a>
				<span>EDGAR local workspace</span>
			</header>
			<div class="application-shell">
				@Sidebar(page.ActiveSection)
				@workspace
			</div>
		</body>
	</html>
}
