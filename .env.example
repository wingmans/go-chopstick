# Default development backfill scope.
EDGAR_SET=us-gaap
EDGAR_FROM_YEAR=2022

# Supported forms selected for automatic local processing.
EDGAR_FORM_TYPES=10-K,10-Q,8-K

# All runtime data, caches, databases, logs, and temporary files live here.
CHOPSTICK_DATA_DIR=./data

# Local NATS connection.
EDGAR_NATS_URL=nats://127.0.0.1:4222

# Filing news HTTP listen address.
EDGAR_NEWS_ADDRESS=127.0.0.1:8081

# Parsed filings web HTTP listen address.
EDGAR_FILINGS_ADDRESS=127.0.0.1:8083

# Identify requests to the SEC with your own contact address.
EDGAR_USER_AGENT=chopstick your-email@example.com

# Use info for progress summaries and debug for individual work decisions.
LOGLEVEL=info
