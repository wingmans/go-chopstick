# Default development backfill scope.
EDGAR_SET=us-gaap
EDGAR_FROM_YEAR=2022

# Financial forms selected for automatic local processing.
EDGAR_FORM_TYPES=10-K,10-K/A,10-Q,10-Q/A,8-K,8-K/A

# All runtime data, caches, databases, logs, and temporary files live here.
CHOPSTICK_DATA_DIR=./data

# Local NATS connection.
EDGAR_NATS_URL=nats://127.0.0.1:4222

# Local chop-to-chopd command connection.
CHOP_COMMAND_ADDRESS=127.0.0.1:8084

# Local web application listen address.
EDGAR_HTTP_ADDRESS=127.0.0.1:8083

# EDGAR_NEWS_ADDRESS and EDGAR_FILINGS_ADDRESS remain temporary fallbacks.

# Identify requests to the SEC with your own contact address.
EDGAR_USER_AGENT=chopstick your-email@example.com

# Mandatory external HTTP gateway. The built-in default has the same value.
CHOP_OUTBOUND_GATEWAY_URL=http://127.0.0.1:8090

# Use info for progress summaries and debug for individual work decisions.
LOGLEVEL=debug
