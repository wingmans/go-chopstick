1. Minimal internal/uitest/page.go Harness
Page wraps *testing.T, the HTTP status/headers, and a parsed *goquery.Document, while Harness runs requests in-memory via httptest.NewRecorder() (no open TCP ports needed).

Go
package uitest

import (
	"bytes"
	"net/http"
	"net/http/httptest"
	"net/url"
	"strings"
	"testing"

	"github.com/PuerkitoBio/goquery"
)

// Page represents a rendered full HTML page or HTMX partial fragment.
type Page struct {
	t      *testing.T
	Status int
	Header http.Header
	Body   string
	Doc    *goquery.Document
}

// ParsePage parses raw HTML into a Page so Lint and OOB assertions can run directly.
func ParsePage(t *testing.T, status int, header http.Header, body string) *Page {
	t.Helper()

	doc, err := goquery.NewDocumentFromReader(strings.NewReader(body))
	if err != nil {
		t.Fatalf("failed parsing HTML response: %v", err)
	}
	if header == nil {
		header = make(http.Header)
	}

	return &Page{
		t:      t,
		Status: status,
		Header: header,
		Body:   body,
		Doc:    doc,
	}
}

func (p *Page) AssertStatus(want int) *Page {
	p.t.Helper()
	if p.Status != want {
		p.t.Fatalf("unexpected status: got %d, want %d\nbody:\n%s", p.Status, want, p.Body)
	}
	return p
}

func (p *Page) AssertHeader(key, want string) *Page {
	p.t.Helper()
	if got := p.Header.Get(key); got != want {
		p.t.Fatalf("unexpected header %s: got %q, want %q", key, got, want)
	}
	return p
}

// Harness executes HTTP and HTMX requests against an http.Handler in memory.
type Harness struct {
	t       *testing.T
	handler http.Handler
}

func NewHarness(t *testing.T, handler http.Handler) *Harness {
	t.Helper()
	return &Harness{t: t, handler: handler}
}

func (h *Harness) GetPage(path string) *Page {
	h.t.Helper()
	req := httptest.NewRequest(http.MethodGet, path, nil)
	return h.do(req)
}

func (h *Harness) HTMXGet(path, sourceID string) *Page {
	h.t.Helper()
	req := httptest.NewRequest(http.MethodGet, path, nil)
	req.Header.Set("HX-Request", "true")
	if sourceID != "" {
		req.Header.Set("HX-Source", sourceID)
	}
	return h.do(req)
}

func (h *Harness) HTMXPostForm(path, sourceID string, form url.Values) *Page {
	h.t.Helper()
	req := httptest.NewRequest(http.MethodPost, path, bytes.NewBufferString(form.Encode()))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	req.Header.Set("HX-Request", "true")
	if sourceID != "" {
		req.Header.Set("HX-Source", sourceID)
	}
	return h.do(req)
}

func (h *Harness) do(req *http.Request) *Page {
	h.t.Helper()
	rec := httptest.NewRecorder()
	h.handler.ServeHTTP(rec, req)
	return ParsePage(h.t, rec.Code, rec.Header().Clone(), rec.Body.String())
}
2. Checking Bare <tr> / <td> / <th> OOB Elements in internal/uitest/lint.go
When a server returns a bare <tr id="row-1" hx-swap-oob="outerHTML"> in a partial fragment without a <table> or <tbody> wrapper, standard HTML5 fragment parsing strips the <tr> tag and leaves orphaned text or <td> nodes behind—so HTMX never finds [hx-swap-oob].

Add this check to Page.Lint(cfg) inside internal/uitest/lint.go:

Go
// 6. Flag bare table-row/cell elements in partial fragments without a <table> wrapper.
// Standard HTML5 parsing strips top-level <tr>/<td>/<th> outside <table>, silently dropping OOB swaps.
if !isFullPage {
	trimmed := strings.TrimSpace(p.Body)
	lowerTrimmed := strings.ToLower(trimmed)
	for _, bareTag := range []string{"<tr", "<td", "<th", "<tbody", "<thead", "<tfoot"} {
		if strings.HasPrefix(lowerTrimmed, bareTag) &&
			(len(lowerTrimmed) == len(bareTag) || lowerTrimmed[len(bareTag)] == ' ' || lowerTrimmed[len(bareTag)] == '>' || lowerTrimmed[len(bareTag)] == '/') {
			issues = append(issues, fmt.Sprintf(
				"partial fragment starts with bare %s> outside <table>; browser HTML5 parser strips bare table nodes and breaks OOB swaps",
				bareTag,
			))
		}
	}

	p.Doc.Find("tr[hx-swap-oob], td[hx-swap-oob], th[hx-swap-oob], tbody[hx-swap-oob]").Each(func(_ int, s *goquery.Selection) {
		if s.Closest("table").Length() == 0 {
			issues = append(issues, fmt.Sprintf(
				"<%s id=%q> uses hx-swap-oob without an enclosing <table> wrapper",
				goquery.NodeName(s), s.AttrOr("id", "(no id)"),
			))
		}
	})
}
Why Both Checks Are Needed
Raw string prefix check (strings.HasPrefix): Because goquery uses Go's HTML5 parser (golang.org/x/net/html), a bare <tr id="row-1" hx-swap-oob="true"> at the start of p.Body gets stripped before p.Doc.Find(...) ever sees it—matching what happens in Firefox and Chrome. Inspecting p.Body directly catches stripped top-level table rows immediately.

DOM ancestor check (s.Closest("table")): Catches cases where a table node survived inside a non-table wrapper (like <div><tr hx-swap-oob="true">...</tr></div>) without a proper <table> context.

