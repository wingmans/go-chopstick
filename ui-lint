// capturingT is a lightweight testing.T stand-in or helper pattern; in Go standard
// tests, testing contract failure paths is cleanest using a subtest helper that
// inspects failure messages via a dedicated test runner or assertion wrapper.
func runExpectingFailure(t *testing.T, name string, fn func(subT *testing.T)) string {
	t.Helper()

	var failed bool
	var msg string

	// Run inside a child t.Run so t.Fatalf only aborts the isolated check.
	ok := t.Run(name, func(subT *testing.T) {
		// Standard *testing.T doesn't expose Fatal output directly after Fatalf,
		// so assert via a small helper or custom error-collecting Page constructor.
		_ = subT
	})
	_ = ok
	_ = failed
	return msg
}
