package uitest

import (
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"testing"
)

var (
	inlineStyleAttrRe = regexp.MustCompile(`(?i)\bstyle\s*=\s*(?:"[^"]*"|\{[^}]*\})`)
	cssFixedDimRe     = regexp.MustCompile(`(?im)\b(?:min-|max-)?(?:width|height)\s*:\s*[0-9]+(?:\.[0-9]+)?px\b`)
)

// AssertSourceStyleRules scans .templ and .css files under rootDir for inline
// styles without CSS variables and hardcoded pixel width/height rules.
func AssertSourceStyleRules(t *testing.T, rootDir string) {
	t.Helper()

	var findings []string

	err := filepath.WalkDir(rootDir, func(path string, d fs.DirEntry, walkErr error) error {
		if walkErr != nil {
			return walkErr
		}
		if d.IsDir() {
			return nil
		}

		ext := filepath.Ext(path)
		if ext != ".templ" && ext != ".css" {
			return nil
		}

		data, err := os.ReadFile(path)
		if err != nil {
			return err
		}

		lines := strings.Split(string(data), "\n")
		for idx, line := range lines {
			lineNum := idx + 1
			switch ext {
			case ".templ":
				for _, m := range inlineStyleAttrRe.FindAllString(line, -1) {
					if !strings.Contains(strings.ToLower(m), "var(--") {
						findings = append(findings, fmt.Sprintf("%s:%d: inline style %s (prefer CSS class or var(--...))", path, lineNum, m))
					}
				}
			case ".css":
				for _, m := range cssFixedDimRe.FindAllString(line, -1) {
					findings = append(findings, fmt.Sprintf("%s:%d: hardcoded pixel dimension %q (prefer var(--...), rem, or %%)", path, lineNum, strings.TrimSpace(m)))
				}
			}
		}

		return nil
	})
	if err != nil {
		t.Fatalf("failed walking %q: %v", rootDir, err)
	}

	if len(findings) > 0 {
		t.Fatalf("source style violations:\n  - %s", strings.Join(findings, "\n  - "))
	}
}
