if cfg.StrictScopedTriggers {
	p.Doc.Find("[hx-trigger]").Each(func(_ int, s *goquery.Selection) {
		raw := strings.TrimSpace(s.AttrOr("hx-trigger", ""))
		id := strings.TrimSpace(s.AttrOr("id", ""))
