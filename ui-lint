Here is a goquery check you can add to uitest to flag hx-trigger attributes that reach outside their own element—such as listening on body, window, document, a from:... selector, or non-local events that bubble across controls.

Go
package uitest

import (
	"fmt"
	"strings"

	"github.com/PuerkitoBio/goquery"
)

// AssertScopedTriggers flags hx-trigger attributes that reference external
// sources (from:...) or global/bubbling scopes, which often cause cross-control
// or cross-browser timing races.
func (p *Page) AssertScopedTriggers(allowExternal bool) *Page {
	p.t.Helper()

	if allowExternal {
		return p
	}

	var issues []string

	p.Doc.Find("[hx-trigger]").Each(func(_ int, s *goquery.Selection) {
		raw := strings.TrimSpace(s.AttrOr("hx-trigger", ""))
		if raw == "" {
			return
		}

		lower := strings.ToLower(raw)
		id := s.AttrOr("id", "(no id)")
		tag := goquery.NodeName(s)

		// Flag explicit external event sources like "keyup from:body" or "change from:#other".
		if strings.Contains(lower, " from:") {
			issues = append(issues, fmt.Sprintf("<%s id=%q> uses external trigger source in hx-trigger=%q", tag, id, raw))
		}

		// Flag global targets that catch events from unrelated controls.
		for _, globalScope := range []string{" from:body", " from:window", " from:document"} {
			if strings.Contains(lower, globalScope) {
				issues = append(issues, fmt.Sprintf("<%s id=%q> listens on global scope in hx-trigger=%q", tag, id, raw))
			}
		}
	})

	if len(issues) > 0 {
		p.t.Fatalf("cross-control hx-trigger check failed:\n  - %s", strings.Join(issues, "\n  - "))
	}

	return p
}
How to Use It in Your Project Linter
Call it inside Page.Lint(cfg) with a StrictScopedTriggers bool field on LintConfig so you can opt into it per page or fragment.

Keep intentional cross-control triggers explicit: If a control genuinely needs from:#other-control or from:body, pass allowExternal: true (or StrictScopedTriggers: false) for that specific test rather than weakening the rule everywhere.

