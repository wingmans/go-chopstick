When you write a new component, StrictScopedTriggers: true flags accidental from:... or from:body listeners immediately; if a specific control genuinely needs to listen to another element, adding its id to AllowedTriggerIDs documents that coupling in one place.

2. Minimal Standalone HTML Repro for Isolating Firefox Keystroke Timing
When you do not yet know which piece of go-topaz-ui causes the Firefox divergence, strip away Go, templ, and CSS into a single static HTML file served over http://localhost (or python3 -m http.server).

This template logs exact browser event order (keydown, input, change, compositionend) and HTMX 4 request/swap lifecycle events (htmx:before:request, htmx:after:swap) with millisecond timestamps so you can compare Firefox and Chrome side-by-side in DevTools:

HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>HTMX 4 Firefox Keystroke Repro</title>
  <!-- Point to your local htmx 4 script -->
  <script src="/static/htmx.min.js"></script>
</head>
<body>
  <section>
    <label for="control-a">Control A (Primary Filter)</label>
    <input
      id="control-a"
      name="q"
      type="search"
      hx-get="/mock-search"
      hx-trigger="input changed delay:200ms"
      hx-target="#results"
      hx-sync="this:replace"
    >

    <label for="control-b">Control B (Secondary / Linked Control)</label>
    <select
      id="control-b"
      name="type"
      hx-get="/mock-search"
      hx-trigger="change, input from:#control-a delay:200ms"
      hx-target="#secondary-panel"
      hx-include="#control-a"
    >
      <option value="all">All</option>
      <option value="user">User</option>
    </select>
  </section>

  <div id="results">Initial results</div>
  <div id="secondary-panel">Initial secondary</div>
  <pre id="event-log"></pre>

  <script>
    const logEl = document.getElementById("event-log");
    const t0 = performance.now();

    function log(msg) {
      const ms = (performance.now() - t0).toFixed(1).padStart(7, " ");
      logEl.textContent += `[${ms}ms] ${msg}\n`;
    }

    // 1. Track native DOM events on both controls
    for (const id of ["control-a", "control-b"]) {
      const el = document.getElementById(id);
      for (const evt of ["keydown", "input", "change", "focus", "blur"]) {
        el.addEventListener(evt, (e) => {
          log(`DOM ${id} :: ${evt} (value=${JSON.stringify(e.target.value)})`);
        });
      }
    }

    // 2. Track HTMX 4 lifecycle events (uses htmx:phase:action naming)
    for (const evt of ["htmx:before:request", "htmx:after:request", "htmx:before:swap", "htmx:after:swap"]) {
      document.addEventListener(evt, (e) => {
        const src = e.target?.id || e.target?.tagName || "unknown";
        log(`HTMX ${evt} on #${src}`);
      });
    }
  </script>
</body>
</html>
